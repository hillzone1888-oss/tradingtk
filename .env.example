# Copy to .env and fill in. .env is gitignored — never commit real values.
# Private keys are referenced BY PATH, never inlined here.

# ─── Moon Dev (optional data provider; read-only) ──────────────────
MOONDEV_API_KEY=

# ─── Kalshi (execution venue) ──────────────────────────────────────
# Trading-only credentials. The RSA private key lives in a file; put its PATH
# here, not its contents.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# ─── Polymarket US (execution venue; added once credentials land) ──
POLYMARKET_US_KEY_ID=
POLYMARKET_US_PRIVATE_KEY_PATH=secrets/polymarket_us_ed25519.pem

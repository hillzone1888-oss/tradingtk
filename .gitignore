# ─── Secrets — never commit ────────────────────────────────────────
.env
*.pem
*.key
secrets/

# ─── Reference material (cloned, not vendored) ─────────────────────
reference/

# ─── Generated / runtime state ─────────────────────────────────────
proposals/
state/
*.sqlite
*.sqlite-journal

# `data/*` rather than `data/` so one child can be re-included below: git will
# not descend into an excluded directory, so a blanket `data/` makes the
# negation impossible.
data/*
# The shadow log IS committed. It is the accumulated evidence, the only thing
# calibration can be computed from, and it is produced by scheduled runs in
# ephemeral cloud environments — uncommitted, it would not survive the run that
# created it. Small: one partition per day of scored forecasts.
!data/shadow/

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# ─── Local config (keep the example, ignore the real one) ──────────
config/config.yaml
!config/config.example.yaml

# ─── OS / editor ───────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# Tape data — large, rewritten per poll, and git handles it badly. Recorded
# fresh and consumed within a run. (Scoped, not a blanket `*.parquet`: the
# shadow log above is parquet too and must not be caught by this.)
data/tape/
